# Connection settings read by db.js (the helper supplied with the brief).
#
# Copy to `.env` for local development, or `.env.supabase` to point at the
# hosted database. Both are gitignored.
#
# ── There are TWO valid shapes, and the difference matters ───────────────────
#
# db.js decides SSL from ONE thing:
#
#     ssl: config.host ? { rejectUnauthorized: false } : false
#
# So setting PG_HOST turns SSL ON. That is right for Supabase and wrong for a
# local container, which speaks no SSL. Locally we therefore leave PG_HOST unset
# and let pg fall back to the standard PGHOST variable instead. That is a
# property of the helper we were given, not something to fix by editing it.


# ── Local development (docker compose up -d) ─────────────────────────────────
# PG_HOST deliberately UNSET so db.js keeps SSL off.
#
# PG_DATABASE=skilltrial
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=devpass


# ── Supabase ─────────────────────────────────────────────────────────────────
# Use the TRANSACTION-MODE POOLER on port 6543, not the direct
# db.<ref>.supabase.co:5432 host.
#
# db.js is written for transaction mode specifically: it caps the pool at 2,
# and its comments spell out what transaction mode forbids — advisory locks,
# bare SET, named prepared statements, temp tables, LISTEN/NOTIFY. Pointing it
# at the direct host would work by accident and hide those constraints until
# they broke under load.
#
# The username is postgres.<project-ref>; the ref is how the pooler knows which
# project a connection belongs to.
#
# PG_HOST=aws-0-<region>.pooler.supabase.com
# PG_PORT=6543
# PG_DATABASE=postgres
# PG_USER=postgres.<project-ref>
# PG_PASSWORD=<the database password, shown once at project creation>
